    "waiting_time": ["waiting_time", "wait_time"],
    "battery_capacity_kWh": ["battery_capacity_kWh", "battery_capacity", "battery_kwh", "Battery Capacity (kWh)"],
    "initial_soc": ["initial_soc", "soc", "state_of_charge", "State of Charge (Start %)"],
    "final_soc": ["final_soc", "end_soc", "State of Charge (End %)"],
    "energy_consumed_kWh": ["energy_consumed_kWh", "energy_consumed", "energy_kwh", "Energy Consumed (kWh)"],
    "charging_power_kW": ["charging_power_kW", "charging_power", "power_kw", "Charging Rate (kW)"],
