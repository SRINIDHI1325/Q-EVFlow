    "vehicle_age": ["vehicle_age", "Vehicle Age (years)"],
    "distance_driven": ["distance_driven", "Distance Driven (since last charge) (km)"],
    "time_of_day": ["time_of_day", "Time of Day"],
    "day_of_week": ["day_of_week", "Day of Week"],
    "charger_type": ["charger_type", "Charger Type"],
    "user_type": ["user_type", "User Type"]
